# The committed lockfile resolves @vite-pwa/astro@1.2.0 alongside astro@7,
# which violates @vite-pwa/astro's peer range (astro ^1-5). That mismatch is
# pre-existing and unrelated to the js-yaml v5 bump; install the locked tree
# as-is rather than failing npm ci on the peer conflict.
legacy-peer-deps=true
