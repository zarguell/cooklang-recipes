{
  "name": "cooklang-recipes",
  "version": "1.0.0",
  "description": "A beautiful static recipe site built with Astro and CookLang",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run copy-recipes",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy-recipes": "cp -r recipes public/",
    "postbuild": "pagefind --site dist"
  },
  "keywords": [
    "astro",
    "cooklang",
    "recipes",
    "static-site"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.0",
    "pagefind": "^1.5.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@tmlmt/cooklang-parser": "^2.0.0",
    "@vite-pwa/astro": "^1.2.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.0.0"
  },
  "overrides": {
    "@vite-pwa/astro": {
      "astro": "$astro"
    }
  }
}